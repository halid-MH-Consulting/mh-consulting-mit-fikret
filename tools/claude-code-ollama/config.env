# Shared configuration for the local Claude Code + Ollama setup.
# Edit this file to change models, ports, or context sizes.

# --- Models -----------------------------------------------------------------
# _BASE is what gets pulled from the Ollama library. The setup script derives a
# `-cc` variant from each with a larger context window baked in (see setup.sh).
#
# Pick a main model that is genuinely good at tool calling -- that is what makes
# or breaks an agent harness. Check https://ollama.com/library for current tags.
#   qwen3-coder:30b   strong coding + tool use, MoE so it runs fast   ~18 GB
#   devstral:24b      built specifically for agentic coding harnesses ~14 GB
#   qwen2.5-coder:14b lighter fallback                                 ~9 GB
OLLAMA_MAIN_BASE="${OLLAMA_MAIN_BASE:-qwen3-coder:30b}"
OLLAMA_FAST_BASE="${OLLAMA_FAST_BASE:-qwen2.5-coder:7b}"

OLLAMA_MAIN_MODEL="$(printf '%s' "$OLLAMA_MAIN_BASE" | tr ':/' '--')-cc"
OLLAMA_FAST_MODEL="$(printf '%s' "$OLLAMA_FAST_BASE" | tr ':/' '--')-cc"

# LiteLLM needs the full provider-prefixed reference (see litellm.config.yaml).
export OLLAMA_MAIN_REF="ollama_chat/${OLLAMA_MAIN_MODEL}"
export OLLAMA_FAST_REF="ollama_chat/${OLLAMA_FAST_MODEL}"

# --- Context window ---------------------------------------------------------
# The single most important setting here. Too small and the agent silently
# forgets its instructions mid-task. Too large and the KV cache eats your RAM.
# 32k is a sane floor for agentic work; raise it if you have headroom.
NUM_CTX_MAIN="${NUM_CTX_MAIN:-32768}"
NUM_CTX_FAST="${NUM_CTX_FAST:-8192}"

# Cap on generated tokens. In Ollama, num_ctx is a SHARED budget for input plus
# output, and Claude Code asks for 32000 output tokens by default -- which on a
# 32768 window leaves about 768 for the prompt. This must stay comfortably below
# NUM_CTX_MAIN or there is no room left to think in.
MAX_OUTPUT_TOKENS="${MAX_OUTPUT_TOKENS:-8192}"

# --- Endpoints --------------------------------------------------------------
export OLLAMA_HOST_URL="${OLLAMA_HOST_URL:-http://127.0.0.1:11434}"
export LITELLM_PORT="${LITELLM_PORT:-4000}"
export LITELLM_URL="http://127.0.0.1:${LITELLM_PORT}"

# Placeholder token. The proxy does not authenticate (see litellm.config.yaml
# for why it cannot), but the Claude Code CLI wants *some* credential present so
# it does not fall through to an interactive login prompt. Any string works.
export LOCAL_PLACEHOLDER_TOKEN="${LOCAL_PLACEHOLDER_TOKEN:-sk-local-ollama}"
